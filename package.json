{
  "name": "@md-with-git/viewer",
  "version": "0.1.5",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yougikou/md-with-git.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/library.d.ts",
  "files": [
    "dist-lib",
    "README.md",
    "README.en.md",
    "README.ja.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist-lib/library.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./host": {
      "types": "./dist-lib/host.d.ts",
      "import": "./dist-lib/host.js"
    },
    "./styles.css": "./dist-lib/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "test:fixtures": "node tests/verify-fixtures.mjs",
    "test:github-provider": "node tests/github-provider-asset-route.mjs",
    "test:local-folder": "node tests/local-folder-provider.mjs",
    "test:local-git": "node tests/run-local-git-browser-regression.mjs",
    "check": "pnpm typecheck && pnpm test:fixtures && pnpm test:github-provider && pnpm test:local-folder",
    "build:web": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "build": "pnpm build:web && pnpm build:lib",
    "prepack": "pnpm build:lib",
    "preview": "vite preview"
  },
  "dependencies": {
    "buffer": "6.0.3",
    "isomorphic-git": "^1.25.0",
    "katex": "^0.18.1",
    "mermaid": "^11.16.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "yaml": "^2.7.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
